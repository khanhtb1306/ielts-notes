  "speakingQuestions": {
    "self": [
      { "q": "What's your name?" },
      { "q": "How do you spell your name?" },
      { "q": "How old are you?" },
      { "q": "When is your birthday?" }
    ],
    "hometown": [
      { "q": "Where do you come from?" },
      { "q": "What do you like about your hometown?" },
      { "q": "Is there anything you dislike about your hometown?" },
      { "q": "Are there any lakes or rivers / woods or forests / hills or mountains in your hometown?" }
    ],
    "job": [
      { "q": "What do you do?" },
      { "q": "Are you a student or are you working?" },
      { "q": "What is your dream job? Why?" }
    ],
    "hobbies": [
      { "q": "What do you often do in your free time? / What are your hobbies?" },
      { "q": "What do you often do on the weekend?" },
      { "q": "Do you like sports? How often?" },
      { "q": "Do you like watching movies?", "subQuestions": [
        "What kinds of movies do you like?",
        "What is your favorite movie?"
      ] },
      { "q": "Do you like reading books?" },
      { "q": "Do you like listening to music?" },
      { "q": "Do you like playing games?" }
    ],
    "daily-routine": [
      { "q": "What time is it in your country?" },
      { "q": "What time do you...", "subQuestions": [
        "get up?",
        "go to school/work?",
        "have breakfast / lunch / dinner?",
        "come home from school/work?",
        "go to bed?"
      ] },
      { "q": "How do you go to school/work?" },
      { "q": "How often do you...", "subQuestions": [
        "phone your friend?",
        "clean the house?",
        "read the newspaper?",
        "have friends round? (When you have friends round, what do you like to do?)"
      ] }
    ],
    "family": [
      { "q": "Do you live in a big family?" },
      { "q": "What does your father / mother do?" },
      { "q": "What does he/she like?" }
    ],
    "appearance": [
      { "q": "What does he/she look like?" },
      { "q": "What kind of hair does he/she have?" },
      { "q": "What kinds of clothes does he/she often wear?" }
    ],
    "personality": [
      { "q": "What is he/she like?" },
      { "q": "Is he/she friendly / talkative / humorous / generous?" }
    ],
    "house": [
      { "q": "What is your favorite room in your house?" },
      { "q": "Can you describe your living room / bedroom / kitchen?" }
    ],
    "trip": [
      { "q": "Do you love traveling?" },
      { "q": "Tell me about one trip you remember the most." },
      { "q": "Tell me about one trip you want to take in the future." }
    ],
    "food-restaurant": [
      { "q": "What are your favorite foods / drinks? Are they good for you?" },
      { "q": "Do you like eating out? How often do you go to a restaurant?" }
    ],
    "health-illness": [
      { "q": "Do you have a healthy diet?" },
      { "q": "Do you exercise? What exercise do you do?" },
      { "q": "Do you often feel stressed?" },
      { "q": "What should you do if you...", "subQuestions": [
        "have a headache / toothache?",
        "have got a cold?"
      ] }
    ]
  },

