      "localFile": "audio/daily/lesson-09/31007-2-1709203109.mp3",
      "bytes": 41116,
      "status": "exists",
      "script": "How do you like the new teachers?",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
