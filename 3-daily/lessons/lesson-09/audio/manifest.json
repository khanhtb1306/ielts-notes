      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203209.mp3",
      "localFile": "audio/daily/lesson-09/31007-13-1709203209.mp3",
      "bytes": 111751,
      "status": "exists",
      "script": "It's difficult to get him to laugh. I guess he's pretty serious",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
