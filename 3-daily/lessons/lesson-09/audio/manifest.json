    {
      "id": "lesson-09-audio-005",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203140.mp3",
      "localFile": "audio/daily/lesson-09/31007-5-1709203140.mp3",
      "bytes": 78305,
      "status": "exists",
      "script": "He loves going out and meeting people. We go to parties all the time",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-006",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203149.mp3",
      "localFile": "audio/daily/lesson-09/31007-6-1709203149.mp3",
      "bytes": 92098,
      "status": "exists",
      "script": "She loves giving things to people. And she doesn't expect anything in return",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-007",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203156.mp3",
      "localFile": "audio/daily/lesson-09/31007-7-1709203156.mp3",
      "bytes": 84583,
      "status": "exists",
      "script": "She never seems to smile. I wonder why she's so serious all the time",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-008",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203164.mp3",
      "localFile": "audio/daily/lesson-09/31007-8-1709203164.mp3",
      "bytes": 67029,
      "status": "exists",
      "script": "All they like to do is sit at home and play computer games",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-009",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203172.mp3",
      "localFile": "audio/daily/lesson-09/31007-9-1709203172.mp3",
      "bytes": 67029,
      "status": "exists",
      "script": "He's kind of shy and not very talkative",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-010",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203179.mp3",
      "localFile": "audio/daily/lesson-09/31007-10-1709203179.mp3",
      "bytes": 51565,
      "status": "exists",
      "script": "She always looks like she's in a bad mood",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-011",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203189.mp3",
      "localFile": "audio/daily/lesson-09/31007-11-1709203189.mp3",
      "bytes": 97122,
      "status": "exists",
      "script": "When someone tells a really funny joke, we all laugh, but she doesn't seem to think it's funny",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
      "id": "lesson-09-audio-012",
      "challengeId": 31007,
      "classChallengeId": "82214",
      "sourceUrl": "https://api-quiz-maker.langgo.vn/storage/audio/1709203200.mp3",
      "localFile": "audio/daily/lesson-09/31007-12-1709203200.mp3",
      "bytes": 77896,
      "status": "exists",
      "script": "He never talks to anyone. He just sits there and talks to himself",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
