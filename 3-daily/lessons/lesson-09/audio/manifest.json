      "localFile": "audio/daily/lesson-09/31007-4-1709203132.mp3",
      "bytes": 50720,
      "status": "exists",
      "script": "He's really friendly and easy to talk to",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
