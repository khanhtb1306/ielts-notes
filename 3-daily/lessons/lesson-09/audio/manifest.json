      "localFile": "audio/daily/lesson-09/31007-3-1709203123.mp3",
      "bytes": 51138,
      "status": "exists",
      "script": "She's great to be with because she makes me laugh all the time",
      "scriptAlternatives": [],
      "scriptSourceIds": [
        "script-content-83608"
      ],
      "hasScript": true,
      "needsScriptReview": false,
      "note": null
    },
    {
